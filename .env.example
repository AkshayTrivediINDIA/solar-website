# ---- Supabase (project settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin (custom dashboard login) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Payments (Razorpay — optional; COD works without it) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (Resend — order notifications; optional) ----
# Create a key at https://resend.com/api-keys. EMAIL_FROM must be a verified
# sender/domain; use "onboarding@resend.dev" only for testing.
RESEND_API_KEY=
EMAIL_FROM="Surya Solar <onboarding@resend.dev>"
# Company inbox that receives every new order (defaults to siteConfig.email).
ORDER_NOTIFICATION_EMAIL=
